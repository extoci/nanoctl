{
  "name": "nanoctl",
  "version": "0.1.0",
  "description": "Remote screen viewing and basic control over WebRTC.",
  "license": "MIT",
  "type": "module",
  "bin": {
    "nanoctl": "src/index.ts"
  },
  "files": [
    "src",
    "go",
    "README.md"
  ],
  "scripts": {
    "dev": "bun run src/index.ts",
    "build:local": "bun build --compile --minify --outfile dist/nanoctl ./src/index.ts",
    "lint": "bun node_modules/oxlint/dist/cli.js src",
    "fmt": "bunx --bun oxfmt --write src README.md"
  },
  "dependencies": {
    "commander": "^14.0.3",
    "ffmpeg-static": "^5.2.0",
    "werift": "^0.22.9"
  },
  "devDependencies": {
    "@types/bun": "^1.3.3",
    "oxlint": "^1.16.0"
  }
}
