{
  "name": "nanoctl",
  "version": "3.0.0-alpha.18",
  "private": true,
  "description": "Fast, secure, browser-based remote desktop.",
  "license": "MIT",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "type": "module",
  "scripts": {
    "build": "bun run build:agent",
    "build:viewer": "bun --filter @nanoctl/viewer build",
    "build:agent": "bun run build:viewer && bun run scripts/cargo.ts build --release --features media",
    "check": "bun run fmt:check && bun run lint && bun run typecheck && bun run test && bun run test:agent",
    "fmt": "oxfmt --write .",
    "fmt:check": "oxfmt --check .",
    "lint": "oxlint --deny-warnings .",
    "audit": "bun audit --audit-level high",
    "typecheck": "node node_modules/@typescript/native/bin/tsc --build && node node_modules/@typescript/native/bin/tsc -p tests/browser/tsconfig.json",
    "test": "bun test apps/viewer packages scripts",
    "test:browser": "bun run build:viewer && playwright test -c tests/browser/playwright.config.ts",
    "test:latency": "bun run build:viewer && NANOCTL_BROWSER_LATENCY=1 playwright test -c tests/browser/playwright.config.ts latency.spec.ts",
    "test:agent": "bun run scripts/cargo.ts test --features rtc",
    "evidence:media": "bun run scripts/verify-media-evidence.ts",
    "evidence:network": "bun run scripts/verify-network-evidence.ts",
    "evidence:performance": "bun run scripts/verify-performance-evidence.ts",
    "clean": "bun run scripts/clean.ts"
  },
  "devDependencies": {
    "@playwright/test": "1.62.0",
    "@types/bun": "1.3.14",
    "@types/node": "24.13.3",
    "@typescript/native": "npm:typescript@7.0.2",
    "oxfmt": "0.60.0",
    "oxlint": "1.75.0",
    "typescript": "5.9.3"
  },
  "overrides": {
    "tinypool": "2.2.0"
  },
  "packageManager": "bun@1.3.14"
}
