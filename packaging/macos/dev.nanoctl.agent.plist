<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
  <dict>
    <key>Label</key>
    <string>dev.nanoctl.agent</string>
    <key>ProgramArguments</key>
    <array>
      <string>/Applications/nanoctl.app/Contents/MacOS/nanoctl</string>
      <string>run</string>
    </array>
    <key>RunAtLoad</key>
    <true/>
    <key>KeepAlive</key>
    <dict>
      <key>SuccessfulExit</key>
      <false/>
    </dict>
    <key>ProcessType</key>
    <string>Interactive</string>
    <key>ThrottleInterval</key>
    <integer>5</integer>
    <key>StandardOutPath</key>
    <string>/Library/Logs/nanoctl/agent.log</string>
    <key>StandardErrorPath</key>
    <string>/Library/Logs/nanoctl/agent.log</string>
  </dict>
</plist>
